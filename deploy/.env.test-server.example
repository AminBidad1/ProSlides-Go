# Copy to deploy/.env.test-server and edit locally on the server.
# This file is an inventory only. Never commit the real env file.
COMPOSE_PROJECT_NAME=proslides-test

# Public address used by the browser and password-reset links.
# For a simple test VPS this may be an IP and port, for example:
# TEST_PUBLIC_URL=http://203.0.113.10:8080
TEST_PUBLIC_URL=http://SERVER_IP:8080
TEST_BIND_ADDR=0.0.0.0
TEST_HTTP_PORT=8080

# Generate a URL-safe secret, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-with-a-random-hex-secret

LOG_LEVEL=INFO
DEPENDENCY_CHECK_TIMEOUT=2s
MIGRATION_TIMEOUT=2m
LIVE_REQUEST_TIMEOUT=10s
DATABASE_POOL_MAX_CONNS=20
DATABASE_POOL_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
SESSION_TTL=168h
PASSWORD_RESET_TTL=15m

# Optional Google login. Leave empty to disable it.
# The same value is used at API runtime and web build time.
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Usually leave these unchanged.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
BASE_REGISTRY=docker.io/library
