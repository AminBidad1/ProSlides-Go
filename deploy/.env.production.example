API_IMAGE=registry.example.com/proslides/api:release-sha
WEB_IMAGE=registry.example.com/proslides/web:release-sha
APP_HTTP_PORT=8080
APP_SUBNET=172.30.0.0/24
LOG_LEVEL=INFO
DATABASE_URL=
REDIS_URL=
MEDIA_STORAGE_BACKEND=r2
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_BUCKET=
MEDIA_R2_API_TOKEN=
DEPENDENCY_CHECK_TIMEOUT=2s
MIGRATION_TIMEOUT=2m
LIVE_REQUEST_TIMEOUT=10s
DATABASE_POOL_MAX_CONNS=50
DATABASE_POOL_MIN_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
SESSION_TTL=168h
AUTH_REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_RESEND_DELAY=60s
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_PEPPER=
PASSWORD_RESET_TTL=15m
PUBLIC_WEB_URL=https://proslides.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ProSlides
SMTP_USE_TLS=true
SMTP_USE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
