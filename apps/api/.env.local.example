APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=INFO
DATABASE_URL=postgres://proslides:proslides@127.0.0.1:5432/proslides?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_STORAGE_PATH=.data/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
DEPENDENCY_CHECK_TIMEOUT=2s
MIGRATION_TIMEOUT=2m
LIVE_REQUEST_TIMEOUT=10s
DATABASE_POOL_MAX_CONNS=50
DATABASE_POOL_MIN_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
SESSION_TTL=168h
AUTH_REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_RESEND_DELAY=60s
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_PEPPER=
PASSWORD_RESET_TTL=15m
PUBLIC_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ProSlides
SMTP_USE_TLS=false
SMTP_USE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
TRUSTED_PROXY_CIDRS=
